# Exemple de variables d'environnement pour le projet.
# Copier ce fichier en .env (non versionné) et adapter les valeurs.

# Génère une nouvelle clé secrète :
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# false en production, true en développement
DJANGO_DEBUG=true

# Hôtes autorisés (séparés par des virgules)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines CSRF de confiance pour HTTPS / domaines secondaires
DJANGO_CSRF_TRUSTED_ORIGINS=

# Forcer la redirection HTTPS en production (true/false)
DJANGO_SECURE_SSL_REDIRECT=true
